# Supabase Postgres connection string — use the SESSION POOLER (port 6543), not the
# direct connection (port 5432). Settings -> Database -> Connection string -> "Session pooler".
# Direct connections from free-tier hosts (Render) can hit Supabase's connection limit.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Added now for Day 2 (Claude categorization) — not used by Day 1 scripts.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
